<mujoco model="g1_29dof scene">
  <include file="g1_29dof_courier.xml"/>

  <option integrator="implicitfast"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <texture type="2d" name="tag5_tex" file="tags/tag36h11_id5.png"/>
    <material name="tag5_mat" texture="tag5_tex" texrepeat="1 1" texuniform="false"/>
    <texture type="2d" name="tag7_tex" file="tags/tag36h11_id7.png"/>
    <material name="tag7_mat" texture="tag7_tex" texrepeat="1 1" texuniform="false"/>
    <material name="table_top" rgba="0.55 0.35 0.20 1"/>
    <material name="wall" rgba="0.85 0.82 0.75 1"/>
    <material name="cabinet" rgba="0.35 0.35 0.40 1"/>
    <material name="post" rgba="0.45 0.45 0.50 1"/>
    <material name="crate" rgba="0.60 0.45 0.25 1"/>
    <texture type="2d" name="tag10_tex" file="tags/tag36h11_id10.png"/>
    <material name="apriltag_id10" texture="tag10_tex" texrepeat="1 1" texuniform="false"/>
    <!-- Parcel box with AprilTag id=10 baked into the front (-X) face via a
         cube texture. type="2d" texture on a rotated thin-box plate would not
         project onto a vertical face (MuJoCo projects 2D textures along
         local +Z), and type="plane" is disallowed in bodies with a freejoint.
         Cube texture sidesteps both restrictions. -->
    <texture type="cube" name="parcel_cube_tex"
             fileleft="tags/parcel_face_tag10.png"
             fileright="tags/parcel_face_brown.png"
             filefront="tags/parcel_face_brown.png"
             fileback="tags/parcel_face_brown.png"
             fileup="tags/parcel_face_brown.png"
             filedown="tags/parcel_face_brown.png"/>
    <material name="parcel_box" texture="parcel_cube_tex"/>
  </asset>


  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" />

    <!-- Room: 8 m x 6 m enclosure for navigation/mapping tests.
         Robot starts at origin facing +X. Walls 2.5 m tall, 0.1 m thick. -->
    <geom name="wall_north" type="box" pos="6 0 1.25" size="0.05 3 1.25" material="wall"/>
    <geom name="wall_south" type="box" pos="-2 0 1.25" size="0.05 3 1.25" material="wall"/>
    <geom name="wall_east"  type="box" pos="2 3 1.25"  size="4 0.05 1.25" material="wall"/>
    <geom name="wall_west"  type="box" pos="2 -3 1.25" size="4 0.05 1.25" material="wall"/>

    <!-- Table A — 1.5 m before robot, AprilTag id5 on near face. -->
    <body name="table_a" pos="1.5 0 0.495">
      <geom name="table_a_top" type="box" size="0.4 0.6 0.39" material="table_top"/>
      <geom name="tag5_plate" type="plane" size="0.08 0.08 0.001"
            pos="-0.41 0 0.30" quat="0.7071 0 -0.7071 0"
            material="tag5_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- Table B — 4 m before robot, AprilTag id7 on near face. -->
    <body name="table_b" pos="4.0 0 0.495">
      <geom name="table_b_top" type="box" size="0.4 0.6 0.39" material="table_top"/>
      <geom name="tag7_plate" type="plane" size="0.08 0.08 0.001"
            pos="-0.41 0 0.30" quat="0.7071 0 -0.7071 0"
            material="tag7_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- Obstacles for nav / SLAM. -->
    <geom name="cabinet" type="box" pos="2.5 1.8 1.0"
          size="0.4 0.4 1.0" material="cabinet"/>
    <geom name="post" type="cylinder" pos="3.0 -1.8 0.6"
          size="0.15 0.6" material="post"/>
    <geom name="crate" type="box" pos="5.0 -1.5 0.2"
          size="0.4 0.4 0.2" material="crate"/>

    <!-- Parcel: cardboard box on table A. Picked up via <equality><weld>
         pin_parcel toggle (rt/parcel_state DDS topic). AprilTag id=10 on top
         face. TODO_TUNE: pos and weld relpose may need adjustment after the
         first pick test (palms in stage P3 must close around the parcel). -->
    <!-- Parcel for v2 palm-press friction grasp.
         Sits on table A top, flush with the front (-X) edge: front face of
         parcel coincides with front face of table A at world X=1.10 (table
         pos 1.5, half-X 0.4, so front edge X=1.10; parcel half-X 0.10 places
         center at X=1.20). Z=0.87 = table top (0.78) + parcel half-Z (0.09).
         Y dimension still 0.139 m for palm-press compression (sep_Y=0.149
         minus 1 cm).
         Tables raised by +0.105 m (brief 0013 pushback) so parcel center
         Z = top biurka (0.885) + half_Z (0.09) = 0.975 = P4 wrist Z. Linux
         keeps real-robot keyframes immutable; sim adapts table height. -->
    <body name="parcel" pos="1.20 0 0.975">
      <freejoint name="parcel_free"/>
      <inertial pos="0 0 0" mass="0.5" diaginertia="0.0022 0.0030 0.0025"/>
      <geom name="parcel_geom" type="box" size="0.10 0.0695 0.09"
            material="parcel_box" friction="2.0 0.1 0.005" condim="3"/>
      <!-- AprilTag id=10 is baked into the parcel_box cube texture on the
           -X face. No separate plate geom needed. -->
    </body>

    <!-- Anchor for pelvis weld - keeps the robot upright for arm tasks
         when there is no walking controller. Sim-only. Remove together
         with the <equality><weld> below when locomotion is added. -->
    <body name="pelvis_anchor" mocap="true" pos="0 0 0.793"/>
  </worldbody>

  <equality>
    <weld name="pin_pelvis" body1="pelvis" body2="pelvis_anchor"
          solref="0.001 1" solimp="0.99 0.99 0.001"/>
    <!-- Freeze the waist so head_cam stays pointed at the tags. Sim-only
         hack for phase 1 arm-only manipulation; remove when adding torso
         control. -->
    <weld name="pin_torso" body1="torso_link" body2="pelvis"
          solref="0.001 1" solimp="0.99 0.99 0.001"/>
    <!-- v1 magnetic weld kept INACTIVE — v2 uses palm-press friction grasp
         (paczka ściskana między dwiema dłońmi). Linux arm_controller no longer
         publishes "carrying" so eq_active stays 0 throughout transit. Kept
         here as a one-line fallback in case palm-press destabilises in some
         future scenario; remove once friction grasp is fully validated. -->
    <weld name="pin_parcel" body1="parcel" body2="right_wrist_yaw_link"
          active="false" relpose="0 0 0  1 0 0 0"
          solref="0.001 1" solimp="0.99 0.99 0.001"/>
  </equality>
  </mujoco>
</mujoco>
