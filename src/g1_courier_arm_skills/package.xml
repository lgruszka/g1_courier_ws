<?xml version="1.0"?>
<package format="3">
  <name>g1_courier_arm_skills</name>
  <version>0.1.0</version>
  <description>Parametric arm controller and PickBox/PlaceBox action servers for the G1 courier stack.</description>
  <maintainer email="lukasz.gruszka90@gmail.com">Lukasz Gruszka</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>g1_courier_msgs</exec_depend>
  <!-- Unitree HG messages, available from unitree_ros2 build: -->
  <exec_depend>unitree_hg</exec_depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
