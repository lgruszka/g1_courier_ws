<?xml version="1.0"?>
<package format="3">
  <name>g1_courier_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configs for the G1 courier stack.</description>
  <maintainer email="lukasz.gruszka90@gmail.com">Lukasz Gruszka</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>g1_courier_arm_skills</exec_depend>
  <exec_depend>g1_courier_docking</exec_depend>
  <exec_depend>g1_courier_mission</exec_depend>
  <exec_depend>g1_courier_safety</exec_depend>
  <exec_depend>g1_description</exec_depend>
  <!-- Heavy ROS dependencies pulled at runtime, not at build: -->
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>apriltag_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
